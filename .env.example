# Server-only secrets for the Cloudflare Pages Function and the data scripts.
# In Cloudflare, set these as Pages environment variables (Production + Preview).
# For local `wrangler pages dev`, copy these into a .dev.vars file (gitignored).
# Never expose the service-role key in browser code.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Bucket holding the large downloadable files served via /api/download.
SUPABASE_STORAGE_BUCKET=factor-data

# Only for scripts/load-panel-to-postgres.mjs when pulling the panel chunks from the
# OLD project's Storage instead of local Data/Derived (optional).
# PANEL_SOURCE_SUPABASE_URL=
# PANEL_SOURCE_SERVICE_ROLE_KEY=
