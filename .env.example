NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this in browser code or a NEXT_PUBLIC_* variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Use supabase-storage in hosted environments. Use local only when all Data files
# exist on disk during development.
DATA_SOURCE=supabase-storage
SUPABASE_STORAGE_BUCKET=factor-data
BACKTEST_REMOTE_CACHE=0
